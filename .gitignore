build/
*.o
*.d

# Auto-review gate scratch: per-commit review logs, the staged diff and the
# last test log (scripts/review/).
.reviews/

# FS-UAE per-file metadata written into a shared mount
*.uaem

.claude/settings.local.json

# Non-redistributable SDKs dropped in locally.  The MorphOS SDK is needed
# for the mos build only; MUI headers come from vendor/texteditor/include.
/tools/mos-sdk/
__pycache__/
*.pyc

# The editor's FASLs beside the sources (lisp/load.lisp compiles them when
# cl-user::*clamacs-compile-fasls* is bound; the release ships them under
# lib/clamacs/) -- never committed, and never picked over a newer source.
*.fasl

# The host frontend's npm packages (host/build.sh installs them from the lockfile)
host/node_modules/
