# Clamacs cross-compilation Makefile -- AmigaOS 3, 68020+.
#
#   make -f Makefile.cross amiga
#
# Flags mirror cl-amiga's Makefile.cross so both repos use one compiler with
# one set of settings.  Two of them are not preferences:
#
#   -Os      this gcc miscompiles flexible-array pointer arithmetic at -O2,
#            and -flto has its own regressions.  Stay here.
#   -DNO_INLINE_STDARG
#            turns off inline/muimaster.h's stdarg MACROS for MUI_NewObject
#            and friends.  They cannot work with the `XxxObject ... End'
#            idiom -- nesting an object macro inside another macro's argument
#            list does not preprocess, because the inner macro is not expanded
#            while the outer call's arguments are being collected, so its
#            parenthesis never balances.  src/muistubs.c supplies real
#            varargs functions instead.
#
# MUI headers come from vendor/texteditor/include, which is why no MUI
# developer kit is needed: that directory has libraries/mui.h, the muimaster
# protos and inlines, mui/TextEditor_mcc.h and the SDI headers.

TOOLCHAIN = $(CURDIR)/tools/m68k-amigaos-gcc/prefix
CC        = $(TOOLCHAIN)/bin/m68k-amigaos-gcc

BUILDDIR = build/cross
SRCDIR   = src
VENDINC  = vendor/texteditor/include

CFLAGS  = -noixemul -mcpu=68020 -msoft-float -std=c99 -Wall -Os \
          -fomit-frame-pointer -DNO_INLINE_STDARG -D__amigaos3__ \
          -I$(SRCDIR) -I$(VENDINC)

# STRIP=1 (default) drops the HUNK_SYMBOL blocks.  STRIP=0 keeps them so
# MuForce / SegTracker hit reports name functions.
STRIP ?= 1
ifeq ($(STRIP),1)
STRIPFLAGS = -s
else
STRIPFLAGS =
endif

LDFLAGS = -noixemul -mcpu=68020 -msoft-float $(STRIPFLAGS)
LDLIBS  = -lamiga

# The portable core, shared verbatim with the host test build.
CORE_SRC = $(SRCDIR)/emacs/keymap.c \
           $(SRCDIR)/emacs/rawkey.c \
           $(SRCDIR)/emacs/command.c \
           $(SRCDIR)/emacs/bindings.c \
           $(SRCDIR)/emacs/killring.c \
           $(SRCDIR)/emacs/minihist.c \
           $(SRCDIR)/emacs/locstack.c \
           $(SRCDIR)/emacs/menudef.c \
           $(SRCDIR)/lisp/token.c \
           $(SRCDIR)/lisp/sexp.c \
           $(SRCDIR)/lisp/indent.c \
           $(SRCDIR)/rexx/diag.c \
           $(SRCDIR)/rexx/queue.c \
           $(SRCDIR)/rexx/symcache.c \
           $(SRCDIR)/rexx/replmsg.c \
           $(SRCDIR)/rexx/dbgmsg.c

# The MUI half.
MUI_SRC  = $(SRCDIR)/main.c \
           $(SRCDIR)/textclass.c \
           $(SRCDIR)/document.c \
           $(SRCDIR)/introspect.c \
           $(SRCDIR)/repl.c \
           $(SRCDIR)/rexxclient.c \
           $(SRCDIR)/rexxport.c \
           $(SRCDIR)/errorwin.c \
           $(SRCDIR)/debugwin.c \
           $(SRCDIR)/inspectwin.c \
           $(SRCDIR)/menu.c \
           $(SRCDIR)/muistubs.c

ALL_SRC = $(CORE_SRC) $(MUI_SRC)
ALL_OBJ = $(patsubst $(SRCDIR)/%.c,$(BUILDDIR)/%.o,$(ALL_SRC))

# verify/realamiga/sendkey: the key-injection tool the unattended run uses
# to put REAL key events through the editor.  Built with the same flags and
# the portable key-spelling code, so `sendkey C-x C-q' means exactly what
# `KEY C-x C-q' means -- one spelling, two depths.
TOOL_OBJ = $(BUILDDIR)/emacs/keymap.o $(BUILDDIR)/emacs/rawkey.o

.PHONY: amiga check-toolchain clean

amiga: check-toolchain $(BUILDDIR)/clamacs $(BUILDDIR)/sendkey

check-toolchain:
	@if [ ! -x "$(CC)" ]; then \
	    echo ""; \
	    echo "  m68k-amigaos-gcc not found at:"; \
	    echo "    $(CC)"; \
	    echo ""; \
	    echo "  Install it with:"; \
	    echo "    ./tools/setup-toolchain.sh"; \
	    echo ""; \
	    exit 1; \
	fi

$(BUILDDIR)/clamacs: $(ALL_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)
	@ls -l $@

$(BUILDDIR)/sendkey: verify/realamiga/sendkey.c $(TOOL_OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $< $(TOOL_OBJ) $(LDLIBS)

$(BUILDDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

-include $(ALL_OBJ:.o=.d)

clean:
	rm -rf $(BUILDDIR)

# Unattended FS-UAE run: boot AmigaOS 3, start clamacs, drive it through its
# own ARexx port, quit.  See verify/realamiga/run-fs-uae.sh for how the boot
# hook is borrowed from the cl-amiga checkout next door.
.PHONY: test-amiga verify-amiga

test-amiga: $(BUILDDIR)/clamacs $(BUILDDIR)/sendkey
	verify/realamiga/run-fs-uae.sh verify/realamiga/verify.fs-uae
	@$(MAKE) --no-print-directory -f Makefile.cross verify-amiga

verify-amiga:
	@if [ ! -f build/amiga/clamacs-test.log ]; then \
	    echo "No test results found. Run FS-UAE first."; exit 1; \
	fi
	@echo "=== clamacs on AmigaOS 3 ==="
	@cat build/amiga/clamacs-test.log
	@if grep -q '^FAIL' build/amiga/clamacs-test.log; then \
	    echo "=== Amiga verification FAILED ==="; exit 1; \
	fi
	@if ! grep -q 'DRIVE-DONE' build/amiga/clamacs-test.log; then \
	    echo "=== Amiga verification FAILED (the driver script did not finish) ==="; \
	    exit 1; \
	fi
	@# The Emacs layer, driven by keys rather than command names.  These go
	@# through the keymaps -- prefix maps, the C-u reader, C-g, the kill
	@# ring, the minibuffer -- which the ARexx commands walk straight past.
	@# The `raw' lines are real IECLASS_RAWKEY events from sendkey, so they
	@# also cover MUI's event routing and the decoder in front of the keymaps.
	@for want in \
	    'OK the menu strip has Open' \
	    'OK forward-char is not a menu item' \
	    'OK Save is dimmed for a clean buffer' \
	    'OK the first edit enabled Save' \
	    'OK the menu saved the buffer' \
	    'OK Save dimmed after the menu saved' \
	    'OK Close Buffer closed it' \
	    'OK the menu ran beginning-of-defun' \
	    'OK Clear Transcript is dimmed outside the REPL' \
	    'OK C-x is pending' \
	    'OK C-g cancelled the prefix' \
	    'OK C-x C-q reported' \
	    'OK C-u 4 C-n moved four lines' \
	    'OK C-w killed the first line' \
	    'OK C-y yanked it back' \
	    'OK M-x opened the minibuffer' \
	    'OK TAB indented' \
	    'OK raw <down> reached the class' \
	    'OK raw C-n ran next-line' \
	    'OK raw M-< (Alt as Meta) reached the top' \
	    'OK raw ESC > acted as Meta' \
	    'OK raw C-x C-q went through the prefix map' \
	    'OK raw RET indented the new line' \
	    'OK raw typing self-inserted'; do \
	    if ! grep -qF "$$want" build/amiga/clamacs-test.log; then \
	        echo "=== Amiga verification FAILED (missing: $$want) ==="; \
	        exit 1; \
	    fi; \
	done
	@if ! grep -q '=== run end ===' build/amiga/clamacs-test.log; then \
	    echo "=== Amiga verification FAILED (the boot script did not finish) ==="; \
	    exit 1; \
	fi
	@# The clamiga leg needs a clamiga that actually came up, which on a
	@# small machine it may not (see docs/memory.md).  When it DID come up,
	@# none of its results are optional -- including the shipped macro's
	@# verdict, since without a Lisp the macro can only bail out.
	@if grep -q 'clamiga ARexx port is' build/amiga/clamacs-test.log; then \
	    for want in \
	        'OK eval-last-sexp on (+ 1 2) echoed 3' \
	        'OK the Clamiga menu woke up with the port' \
	        'OK Start clamiga is dimmed while connected' \
	        'OK the editor answered while a load was in flight' \
	        'OK clamacs-load-buffer reported 2 error(s)' \
	        'OK Next Error woke up with the diagnostics' \
	        'OK next-error jumped to the first error' \
	        'OK next-error jumped to the second error' \
	        'OK previous-error went back to' \
	        'OK intro.lisp loaded' \
	        'OK the idle timer had the arglist ready' \
	        'OK M-. jumped to the definition of twice' \
	        'OK M-, returned to' \
	        'OK C-c RET expanded once' \
	        'OK C-c M-m expanded fully' \
	        'OK C-c C-d d prompted' \
	        'OK DESCRIBE opened' \
	        'OK the description carries the docstring' \
	        'OK C-c C-d a prompted' \
	        'OK APROPOS opened' \
	        'OK APROPOS tagged the function and the macro' \
	        'OK M-TAB completed twice-a in place' \
	        'OK C-M-i handed the candidates to the minibuffer' \
	        'OK TAB listed them' \
	        'OK TAB narrowed twice-a to one' \
	        'OK RET put the completion in the buffer' \
	        'OK C-c C-z opened *clamacs-repl*' \
	        'OK Clear Transcript is live in the REPL window' \
	        'OK the REPL prompt arrived' \
	        'OK RET evaluated (+ 1 2) at the prompt' \
	        'OK a new prompt followed the value' \
	        'OK output was streamed line by line before the value' \
	        'OK READLINE armed the input' \
	        'OK RET answered READ-LINE and the value came back' \
	        'OK C-c C-c interrupted (loop)' \
	        'OK the prompt followed IN-PACKAGE' \
	        'OK and back to CL-USER' \
	        'OK M-p brought back the last input' \
	        'OK a second M-p went one further back' \
	        'OK M-n came back to the empty input' \
	        'OK the port answered ARGLIST while the REPL ran a form' \
	        'OK C-c C-z raised the REPL again' \
	        'OK an error at the prompt opened the debugger' \
	        'OK the Debugger item woke up with the debugger' \
	        'OK the Debugger item dimmed with the restart' \
	        'OK RET at the prompt is refused while debugging' \
	        'OK clamacs-debugger-eval prompted' \
	        'OK the frame eval saw the locals by name' \
	        'OK an error in the frame eval nested the debugger' \
	        'OK ABORT returned to level 1' \
	        'OK RESTART 0 returned to the prompt' \
	        'OK the transcript says the form was aborted' \
	        'OK CERROR opened the debugger' \
	        'OK CONTINUE let the form finish' \
	        'OK C-c I prompted' \
	        'OK the inspector showed the object' \
	        'OK part 1 descended into the cdr' \
	        'OK Back came up to the list again'; do \
	        if ! grep -qF "$$want" build/amiga/clamacs-test.log; then \
	            echo "=== Amiga verification FAILED (missing: $$want) ==="; \
	            exit 1; \
	        fi; \
	    done; \
	    if ! grep -qE 'Loaded |Load failed:' build/amiga/clamacs-test.log; then \
	        echo "=== Amiga verification FAILED (the shipped macro reached no verdict) ==="; \
	        exit 1; \
	    fi; \
	else \
	    echo "NOTE: clamiga did not come up -- the integration leg was skipped."; \
	fi
	@echo "=== Amiga verification PASSED ==="
