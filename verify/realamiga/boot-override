; boot-override -- what the emulated system runs instead of cl-amiga's test
; suite.  Consumed (copied to RAM: and deleted) by cl-amiga's
; call-on-ustartup, so it can never hijack a later cl-amiga run.
;
; The editor is a GUI program, so the test drives it the way a user's macro
; would: through its own ARexx port.  That needs ARexx running, which the
; Workbench image does not start on its own.
cd Clamacs:
echo "=== run start ===" >build/amiga/clamacs-test.log
avail >>build/amiga/clamacs-test.log
run >NIL: SYS:System/RexxMast
SYS:Rexxc/WaitForPort REXX
IF WARN
  echo "FAIL RexxMast did not start" >>build/amiga/clamacs-test.log
  SKIP done
ENDIF
echo "OK ARexx is running" >>build/amiga/clamacs-test.log
stack 65000

; Start clamiga FIRST, with its development port open -- the same two lines
; a user puts in S:.clamigarc, just without the interactive REPL.  Order
; matters on a small machine: whoever asks first gets the large contiguous
; block, and a Lisp heap needs one.  Run from the cl-amiga tree so
; (require "amiga/arexx") finds its lib/.
;
; Its output goes to a file of its own: a clamiga that dies on startup says
; why, and mixing that into the editor's log would bury it.
IF EXISTS CLAmiga:build/cross/clamiga
  cd CLAmiga:
  run >Clamacs:build/amiga/clamiga.log build/cross/clamiga --no-userinit --heap 2M --non-interactive --load Clamacs:verify/realamiga/arexx-host.lisp
  cd Clamacs:
  C:Wait 15
ELSE
  echo "INFO no clamiga binary; the integration leg will be skipped" >>build/amiga/clamacs-test.log
ENDIF

run >>build/amiga/clamacs-test.log build/amiga/clamacs Clamacs:verify/realamiga/sample.lisp
; drive.rexx does its own bounded wait for the port and reports what it
; found if it is not there, which is more useful than WaitForPort's silent
; ten-second give-up.
SYS:Rexxc/RX Clamacs:verify/realamiga/drive.rexx >>build/amiga/clamacs-test.log
; The shipped macro, run exactly as a user would run it.  It is one of the
; phase-1 acceptance criteria, and running it here is the only way to know
; the example in examples/ actually works.
echo "=== examples/arexx/load-current-file.rexx ===" >>build/amiga/clamacs-test.log
SYS:Rexxc/RX Clamacs:examples/arexx/load-current-file.rexx >>build/amiga/clamacs-test.log

; With the editor STILL RUNNING: this is the reading that says what clamacs
; costs.  Taking it after it exits would measure what it failed to give back.
echo "=== avail with clamacs running ===" >>build/amiga/clamacs-test.log
avail >>build/amiga/clamacs-test.log
SYS:Rexxc/RX Clamacs:verify/realamiga/quit.rexx >>build/amiga/clamacs-test.log
C:Wait 3
echo "=== avail after clamacs exited ===" >>build/amiga/clamacs-test.log
avail >>build/amiga/clamacs-test.log
LAB done
echo "=== run end ===" >>build/amiga/clamacs-test.log
C:UAEquit
